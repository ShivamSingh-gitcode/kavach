# Kavach local demo configuration
KAVACH_DEMO_MODE=auto

# Local Faster-Whisper defaults: tiny + CPU + int8 for a hackathon laptop.
# Set KAVACH_WHISPER_DEVICE=auto to try CUDA/FP16 first.
KAVACH_WHISPER_MODEL=tiny
KAVACH_WHISPER_MODEL_PATH=
KAVACH_WHISPER_DEVICE=cpu
KAVACH_WHISPER_CPU_THREADS=4
KAVACH_WHISPER_LANGUAGE=
KAVACH_WHISPER_BEAM_SIZE=1
KAVACH_WHISPER_VAD_FILTER=true

# Set to 1/true to skip Whisper and use the deterministic audio transcript.
KAVACH_DISABLE_WHISPER=0

PORT=5000
